{
  "name": "firstmate-ai",
  "version": "0.1.0",
  "description": "Local AI task orchestration with Effect and the Claude Agent SDK",
  "type": "module",
  "license": "UNLICENSED",
  "engines": { "node": ">=24.0.0 <25 || >=26.0.0" },
  "bin": { "firstmate": "dist/cli.js" },
  "exports": { ".": "./dist/index.js" },
  "files": ["dist", "README.md", "docs"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:live": "npm run build && node --test tests/live.mjs",
    "start": "node dist/cli.js",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.296",
    "effect": "4.0.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
